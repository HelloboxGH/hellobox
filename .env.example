# Copy to apps/web/.env.local and apps/worker/.env.local.
APP_URL=http://127.0.0.1:3010
DATABASE_URL=
REDIS_URL=
RSPAMD_URL=http://127.0.0.1:11333
# Who people write to about a suspended account or workspace. Empty says to ask whoever runs
# this instance.
SUPPORT_EMAIL=
# openssl rand -base64 32
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
# Comma-separated emails that can sign in to hellobox-admin. Empty turns the admin API off.
ADMIN_EMAILS=
# They also get an email at the end of each day that had signups, in this time zone.
ADMIN_DIGEST_TIMEZONE=UTC

RESEND_OAUTH_CLIENT_ID=
RESEND_OAUTH_CLIENT_SECRET=
# Cloudflare OAuth client, so domain records can be written to Cloudflare. Leave empty to hide it.
CF_CLIENT_ID=
CF_CLIENT_SECRET=
# Product emails such as verification. Without it, development logs them instead.
RESEND_API_KEY=
# The sender for those emails, on a domain verified in that Resend account, for example
# HelloBox <hello@example.com>. Required with RESEND_API_KEY. Links in them use APP_URL.
EMAIL_FROM=
# Where replies go: the sender's username on this domain, so hello@mail.example.com gets
# replies at hello@example.com. Empty leaves replies to the sender address.
REPLY_TO_DOMAIN=

# Amazon SES connections. Outputs of infra/aws/broker.yaml, plus an access key for its
# hellobox-broker user. Leave empty to hide "Connect Amazon SES".
AWS_BROKER_ACCOUNT_ID=
AWS_BROKER_ACCESS_KEY_ID=
AWS_BROKER_SECRET_ACCESS_KEY=
AWS_TEMPLATES_BASE_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Notifications (Settings → Notifications). Each channel shows up once its variables are set.
# Discord "Connect" button (web): discord.com/developers/applications, OAuth2, no bot.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Slack "Add to Slack" button (web): api.slack.com/apps, scope incoming-webhook.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Telegram bot from @BotFather. Token on web and worker; the worker registers the webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Browser push: bunx web-push generate-vapid-keys, once. Never rotate them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push service. Defaults to SUPPORT_EMAIL, then APP_URL.
VAPID_SUBJECT=
# Our ntfy server. NTFY_TOKEN (the hellobox user's token) belongs on the worker only.
NTFY_URL=
NTFY_TOKEN=
