# HelloBox settings.
#
# Self-hosting with Docker: copy this file to docker/.env and follow docs/self-hosting/.
# Local development: copy it to apps/web/.env.local and apps/worker/.env.local, then run
# `bun run services:up`. The values below already work with docker/compose.dev.yml.
#
# "Required" means HelloBox doesn't work without it. Everything else is optional: leave the
# line empty to switch the feature off.

# ── Core ───────────────────────────────────────────────────────────────────────────────

# Required. The public address of this instance, no trailing slash. Sign-in links, webhook
# URLs and emails all use it, so it has to be the address people type in a browser.
# Example: https://mail.example.com
APP_URL=http://127.0.0.1:3010

# Required. Encrypts provider keys and tokens in the database. Exactly 32 random bytes,
# base64. Make it once and keep it: lose it and every connection has to be set up again.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# Required. Signs sessions. Any long random string. Changing it signs everyone out.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Who people write to about a suspended account. Empty tells them to ask whoever
# runs this instance. Example: help@example.com
SUPPORT_EMAIL=

# ── Docker (docker/compose.yml only) ───────────────────────────────────────────────────

# Which release to run. Releases are named by date (YEAR.MONTH.N). Pin one for a server you
# care about, such as 2026.11.1, and change it to upgrade. `latest` follows the newest release.
HELLOBOX_VERSION=latest

# Required. Passwords for the Postgres and Redis containers. Compose builds the
# DATABASE_URL and REDIS_URL for the app from them, so use letters and numbers only.
# Generate each: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional. Starts the bundled object storage (see Storage below). Remove the line to use
# your own S3 instead.
COMPOSE_PROFILES=storage

# Optional. Ports on this machine that your reverse proxy forwards to.
WEB_PORT=3000
STORAGE_PORT=9000

# ── Database, queue and spam filter ────────────────────────────────────────────────────

# Required for development. With docker/compose.yml these three are set for you and these
# lines are ignored.
# Postgres connection URL. Example: postgres://user:password@host:5432/hellobox
DATABASE_URL=postgres://hellobox:hellobox@127.0.0.1:5432/hellobox
# Redis connection URL, for the job queue. Example: redis://:password@host:6379
REDIS_URL=redis://127.0.0.1:6379
# rspamd's address, for spam checks. Example: http://rspamd:11333
RSPAMD_URL=http://127.0.0.1:11333

# ── Storage ────────────────────────────────────────────────────────────────────────────
# Where attachments and the raw copy of every message live. Required: set either the S3_*
# group or the R2_* group. If both are complete, S3_* is used.

# Any S3-compatible service: the bundled storage container, AWS S3, Backblaze B2, Wasabi...
# Bucket name. Example: hellobox
S3_BUCKET=hellobox
# Access key. With the bundled storage you choose it: openssl rand -hex 12
S3_ACCESS_KEY_ID=
# Secret key. With the bundled storage you choose it: openssl rand -hex 24
S3_SECRET_ACCESS_KEY=
# The service's address as this server reaches it. Empty for AWS S3.
# Example: http://storage:9000 (bundled), https://s3.us-west-004.backblazeb2.com
S3_ENDPOINT=http://storage:9000
# The address browsers use for downloads and uploads. Required with the bundled storage,
# where it has to be reachable from the internet. Empty uses S3_ENDPOINT, which is right
# for hosted services. Example: https://files.example.com
S3_PUBLIC_ENDPOINT=
# Optional. The service's region. Default us-east-1. Example: eu-west-1
S3_REGION=
# Optional. true puts the bucket in the path (host/bucket/key) instead of the host name
# (bucket.host/key). Default true when S3_ENDPOINT is set, false for AWS S3.
S3_FORCE_PATH_STYLE=

# Cloudflare R2, the other way to set up storage. Used when the S3_* group is incomplete.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Email HelloBox sends itself ────────────────────────────────────────────────────────
# Sign-in verification links, password resets and invitations. Set either an SMTP server or
# a Resend API key. They are separate from the provider you connect for your own mail.

# Required in production, unless people only sign in with Google or GitHub below. An SMTP
# server HelloBox sends through. smtp:// is port 587 with STARTTLS, smtps:// is port 465.
# Percent-encode special characters in the password (@ is %40). Wins over RESEND_API_KEY.
# Example: smtp://user:password@smtp.example.com:587
SMTP_URL=
# The other way: a Resend API key with permission to send. Example: re_xxxxxxxx
RESEND_API_KEY=
# Required with either of the above. The sender, on a domain that server may send from.
# Example: HelloBox <hello@example.com>
EMAIL_FROM=
# Optional. Where replies to those emails go: the sender's name on this domain, so
# hello@mail.example.com gets replies at hello@example.com. Empty leaves replies to the sender.
REPLY_TO_DOMAIN=

# ── Sign in with Google or GitHub ──────────────────────────────────────────────────────
# Optional. Each shows its button once both of its variables are set. The callback URLs are
# APP_URL/api/auth/callback/google and APP_URL/api/auth/callback/github.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Providers ──────────────────────────────────────────────────────────────────────────
# Postmark and Mailgun need nothing here: you paste their keys in Settings.

# Optional. Resend connects over OAuth, which needs an OAuth app registered with Resend.
# Without these, "Connect Resend" doesn't work.
RESEND_OAUTH_CLIENT_ID=
RESEND_OAUTH_CLIENT_SECRET=

# Optional. Amazon SES connects through a role in each customer's AWS account that trusts an
# AWS account you run (the broker). Leave all empty to hide "Connect Amazon SES".
# The AWS account id of the broker, 12 digits.
AWS_BROKER_ACCOUNT_ID=
# An access key for the broker's IAM user.
AWS_BROKER_ACCESS_KEY_ID=
AWS_BROKER_SECRET_ACCESS_KEY=
# Optional. Default us-east-1.
AWS_BROKER_REGION=
# Where the CloudFormation templates for the customer's account are hosted, a public URL.
AWS_TEMPLATES_BASE_URL=

# Optional. A Cloudflare OAuth client, so DNS records can be written to Cloudflare for you.
# Leave empty to hide it.
CF_CLIENT_ID=
CF_CLIENT_SECRET=

# ── Sign-ups and admin ─────────────────────────────────────────────────────────────────

# Optional. false closes registration: only the addresses in ADMIN_EMAILS and people with a
# workspace invitation can create an account. Anything else leaves sign-ups open.
ALLOW_SIGNUPS=

# Optional. Comma-separated emails that can sign in to the hellobox-admin tool. Empty turns
# the admin API off. Example: you@example.com
ADMIN_EMAILS=
# Optional. They also get an email at the end of each day that had signups, in this time
# zone (it needs SMTP_URL or RESEND_API_KEY above). Default UTC.
ADMIN_DIGEST_TIMEZONE=UTC

# ── Notifications (Settings → Notifications) ───────────────────────────────────────────
# Optional. Email notifications work without any of this. Each channel below shows up once
# its variables are set.

# Discord "Connect" button: discord.com/developers/applications, OAuth2, no bot.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Slack "Add to Slack" button: api.slack.com/apps, scope incoming-webhook.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Telegram bot from @BotFather. The token goes on web and worker; the worker registers the
# webhook with Telegram, so APP_URL has to be public.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any random string. Telegram sends it back with each call. Generate: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=
# Browser push. Generate once with `bunx web-push generate-vapid-keys`, and never rotate.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: contact for the push service. Defaults to SUPPORT_EMAIL, then APP_URL.
VAPID_SUBJECT=
# An ntfy server for ntfy notifications. Example: https://ntfy.example.com
NTFY_URL=
# The token of the ntfy user HelloBox publishes as. Worker only.
NTFY_TOKEN=
# Cloudflare Turnstile for public support forms. Optional: without it, forms rely on a hidden
# field and rate limits. Messages that fail the check go to Spam. Web only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# HelloBox's own mail server (apps/mx) signs each email it posts with this, and needs the
# same value. Unset: receiving with HelloBox is off. Generate: openssl rand -hex 32. Web only.
MX_SIGNING_KEY=
# The mail server's name, the same as its own MX_HOSTNAME, like mx1.example.com. Settings
# tells domains to point their MX record here. Unset: receiving with HelloBox is off. Web only.
MX_HOSTNAME=
